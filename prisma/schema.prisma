generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Emulating Supabase Auth User
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  debts        Debt[]
  budgets      Budget[]
  createdAt    DateTime      @default(now())
  subscriptions Subscription[]
}

model Account {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String        // e.g., "Main Checking", "Cash"
  type         String        // e.g., "bank", "mobile", "wallet"
  balance      Decimal       @default(0.00)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscriptions Subscription[]
}

model Category {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String        // e.g., "Food", "Transport"
  type         String        // "income" or "expense"
  transactions Transaction[]
  budgets      Budget[]
  subscriptions Subscription[]
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  BORROW
  DEBT_REPAYMENT
  LEND
  LOAN_COLLECTION
  ADJUSTMENT
}

model Transaction {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account         @relation(fields: [accountId], references: [id])
  type             TransactionType
  amount           Decimal
  currency         String          @default("USD")
  categoryId       String?
  category         Category?       @relation(fields: [categoryId], references: [id])
  counterpartyName String?
  note             String?
  transactionDate  DateTime        @default(now())
  status           String          @default("COMPLETED")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Debt {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String   // "Owe" or "Lent"
  counterpartyName String
  amount           Decimal
  remainingAmount  Decimal
  dueDate          DateTime?
  status           String   @default("OPEN") // OPEN, OVERDUE, SETTLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
model Budget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  // The monthly limit
  month      Int      // 1-12
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month, year]) // One budget per category per month
}
model Subscription {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  amount       Decimal
  billingCycle String    @default("MONTHLY") // 'MONTHLY' or 'YEARLY'
  nextDate     DateTime
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}